script = ExtResource("1_32eys")
id = "park_waiter2_confession"
speaker = "Waiter #2"
lines = Array[String](["Stay back!", "Please!", "I didn't want to!", "He... he brought this on himself!", "That bastard was blackmailing me, threatening to kill my family over debts, forcing me to run his damn illegal trade!", "When I tried to walk away, he... he grabbed the knife himself!", "I was just defending myself..."])
