[resource]
script = ExtResource("1_h5flp")
id = "waiter1_plea"
speaker = "Waiter #1"
lines = Array[String](["The manager strictly forbids anyone near his office!", "Even calling the cops has to go through him.", "But he's not picking up his phone.", "Regular staff aren't even allowed within ten feet of the door,", "we'd get fired on the spot.", "But you... you're a professional.", "Can you just take a quick look before the boss gets back?", "Otherwise, we're all screwed."])
